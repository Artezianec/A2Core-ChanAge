          "type": "notice",
          "text": "Kashapa calls for help!",
          "text_ru": "Кашапа зовёт на помощь!",
          "size": 22,
          "color": "FFB040"
        },
        {
          "type": "summon",
          "npc": 2301019,
          "count": 3,
          "radius": 600,
          "target": "victim"
        }
      ],
      "note": "boss-phases.json (OURS)"
