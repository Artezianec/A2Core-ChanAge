      "note": "Kept from the generic boss-phases.json script (OURS): +20% damage at 50%."
    },
    {
      "id": "necromancy_easy",
      "when": {"type": "timer", "after_ms": 15000, "every_ms": 110000},
      "difficulty": ["Easy"],
      "do": [
        {
          "type": "notice",
          "text": "Lycan Necromancy! Kill every spirit before the gauge fills or the party dies!",
          "text_ru": "Некромантия ликанов! Убейте всех духов, пока не заполнится шкала, иначе группа погибнет!"
        },
        {
          "type": "cast",
          "skill": 1607010,
          "wind_up_ms": 1467,
          "radius": 300,
          "once": true,
          "land": false,
          "on_land": [
            {"type": "summon", "npc": 2310904, "count": 2, "radius": 900, "at": "boss", "group": "spirits"},
            {
              "type": "shield",
              "id": "necromancy",
              "invuln": true,
              "until": "adds_dead:spirits",
              "duration_ms": "$necro_ms",
              "on_break": [
                {"type": "notice", "text": "The spirits are gone!", "text_ru": "Духи уничтожены!"}
              ],
              "on_expire": [
                {
                  "type": "wipe",
                  "text": "The gauge is full: the spirits drain the party!",
                  "text_ru": "Шкала заполнена: духи высасывают жизнь группы!"
                }
              ]
            }
          ]
        }
      ]
