{
  "$schema": "../boss-mechanics.schema.json",
  "id": "reforged_abyss_rahu",
  "display": "Rahu (Lagta) - Abyssal Forge",
  "display_ru": "Раху (Лагта) - Бездонная кузница",
  "dungeon": "ReforgedAbyss_Normal",
  "source": "Client data 2.0.9.0 (NpcData skill ids / Skill.dat casts, areas, MaxHPRatio rows, NpcSpawn rows, abyss-stone skills 1910503-05) + boss-phases.json (call / enrage phases, OURS). Mark: CANDIDATE = guessed. Ludra Hard (2300xxx) has no map rows in the repo: ids and spawns are derived from Normal by tools/ludra_arkanis_data.py; its skills and values equal Normal's (CANDIDATE).",
  "note": "First boss of the Sanctuary raid. Client has no berserk for Rahu (bUseBossBerserk false), so no enrage timer; Hard may carry the 4-minute frenzy (CANDIDATE, not applied). NOT implemented: the quadrant floor split with the knock-off dash and the Devourer feeding (no NpcData for the Devourers in 2.0.9.0, no floor-piece data).",
  "npcs": {
    "Normal": [
      2301006
    ],
    "Hard": [
      2300282
    ]
  },
  "arena": {
    "centre": "home",
    "radius": 3500
  },
  "rotation": [
    {
      "type": "cast",
      "skill": 1802760,
      "every_ms": 8000,
      "wind_up_ms": 1000,
      "radius": 900
    },
    {
      "type": "cast",
      "skill": 1802730,
      "every_ms": 12000,
      "wind_up_ms": 1500,
      "radius": 1200
    },
    {
      "type": "cast",
      "skill": 1802740,
      "every_ms": 12000,
      "wind_up_ms": 1470,
      "radius": 700
    },
    {
      "type": "cast",
      "skill": 1802800,
      "every_ms": 15000,
      "wind_up_ms": 1500,
      "radius": 800
    },
    {
      "type": "cast",
      "skill": 1802810,
      "every_ms": 22000,
      "wind_up_ms": 3000,
      "radius": 700,
      "damage": {
        "scale": 1.19
      },
      "warning": "Lagta gathers power: get out of reach!",
      "warning_ru": "Лагта собирает силу: отойдите подальше!"
    }
  ],
  "rules": [
    {
      "id": "phase0_call",
      "when": {
        "type": "hp_below",
        "pct": 60
      },
      "once": true,
      "do": [
        {
          "type": "modify",
          "mode": "phase"
        },
        {
          "type": "notice",
          "text": "Lagta calls for help!",
          "text_ru": "Лагта зовёт на помощь!",
          "size": 22,
          "color": "FFB040"
        },
        {
          "type": "summon",
          "npc": 2301019,
          "count": 3,
          "radius": 600,
          "target": "victim"
        }
      ],
      "note": "boss-phases.json (OURS)"
    },
    {
      "id": "phase1_enrage",
      "when": {
        "type": "hp_below",
        "pct": 30
      },
      "once": true,
      "do": [
        {
          "type": "modify",
          "mode": "phase",
          "damage_mul": 1.25,
          "haste_mul": 0.85
        },
        {
          "type": "notice",
          "text": "Lagta is enraged!",
          "text_ru": "Лагта в ярости!",
          "size": 22,
          "color": "FFB040"
        }
      ],
      "note": "boss-phases.json (OURS)"
    },
    {
      "id": "curse_bomb",
      "when": {
        "type": "timer",
        "after_ms": 14000,
        "every_ms": 32000
      },
      "note": "Rahu's Curse (skill 1802710 / abnormal 18027101): a player is cursed and must hand it to a party member; if nobody stands with them when it runs out a black hole opens; three black holes wipe. Official talk/skill ids; the 20 s timer, 32 s period and 3 holes are CANDIDATE (guide).",
      "do": [
        {
          "type": "mark",
          "name": "curse",
          "target": "random_player",
          "text": "Rahu's curse is on you! Pass it: stand next to an ally!"
        },
        {
          "type": "debuff",
          "debuff": "rahu_curse",
          "target": "mark:curse",
          "abnormal": 18027101,
          "duration_ms": 20000
        },
        {
          "type": "stack",
          "id": "curse_pass",
          "at": "mark:curse",
          "radius": 600,
          "min_players": 2,
          "delay_ms": 20000,
          "on_success": [
            {
              "type": "cleanse",
              "debuff": "rahu_curse"
            }
          ],
          "on_fail": [
            {
              "type": "counter",
              "counter": "blackholes",
              "add": 1
            },
            {
              "type": "notice",
              "text": "A black hole opens!",
              "text_ru": "Открылась чёрная дыра!",
              "size": 22,
              "color": "FFB040"
            },
            {
              "type": "zone",
              "id": "black_hole",
              "at": "mark:curse",
              "shape": "circle",
              "radius": 450,
              "tick_ms": 1000,
              "damage": {
                "fixed": [
                  3000,
                  4000
                ]
              },
              "decal": false
            }
          ]
        }
      ]
    },
    {
      "id": "black_holes_wipe",
      "when": {
        "type": "counter_reached",
        "counter": "blackholes",
        "value": 3
      },
      "do": [
        {
          "type": "wipe",
          "text": "Three black holes tore the arena apart."
        }
      ]
    },
    {
      "id": "thread",
      "when": {
        "type": "timer",
        "after_ms": 24000,
        "every_ms": 38000
      },
      "note": "Thread of Gaps (1802860, cast 2900): a lethal 1600-wide line across the arena (client area, MaxHPRatio 500%). Official skill; timing CANDIDATE.",
      "do": [
        {
          "type": "cast",
          "skill": 1802860,
          "wind_up_ms": 2900,
          "radius": 800,
          "damage": {
            "skill": 1802860,
            "ratio": true
          },
          "warning": "A thread of void cuts the arena: step out of the line!",
          "warning_ru": "Нить пустоты рассекает арену: выйдите из линии!"
        }
      ]
    },
    {
      "id": "grief",
      "when": {
        "type": "hp_below",
        "pct": 55
      },
      "once": true,
      "note": "Bonds of Grief (talk Rahu_*): everyone is pulled to the arena edge and must regroup on one marked player or fail. Official behaviour per the guides; thresholds and the radius are CANDIDATE.",
      "do": [
        {
          "type": "notice",
          "text": "Bonds of grief! Gather on the marked player!",
          "text_ru": "Узы скорби! Соберитесь у отмеченного!",
          "size": 22,
          "color": "FFB040"
        },
        {
          "type": "displace",
          "mode": "to_radius",
          "at": "arena_centre",
          "radius": 3300
        },
        {
          "type": "mark",
          "name": "bond",
          "target": "random_player"
        },
        {
          "type": "stack",
          "id": "grief_gather",
          "at": "mark:bond",
          "radius": 700,
          "min_players": 4,
          "delay_ms": 9000,
          "on_fail": [
            {
              "type": "wipe",
              "text": "The bonds snapped shut."
            }
          ]
        }
      ]
    },
    {
