  "npcs": {
    "Easy": [2310171],
    "Normal": [2300171],
    "Hard": [2320171]
  },
  "vars": {
    "frenzy_ms": 300000,
    "pillar_offset": 1200,
    "cover_depth": 900,
    "cover_width": 1400
  },
  "rotation": [
    {
      "type": "cast",
      "skill": 1800060,
      "every_ms": 20000,
      "wind_up_ms": 2000,
      "radius": 5600,
      "warning": "Ultimate Berk draws a cross: move out of the beams!",
      "warning_ru": "Берк чертит крест: выйдите из лучей!"
    },
    {
      "type": "cast",
      "skill": 1800030,
      "every_ms": 15000,
      "wind_up_ms": 2000,
      "radius": 3700,
      "warning": "Ultimate Berk slashes a line: get behind him or out of the strip!",
      "warning_ru": "Берк бьёт полосой: зайдите за спину или отойдите в сторону!"
    },
    {
      "type": "cast",
      "skill": 1800040,
      "every_ms": 15000,
      "wind_up_ms": 2500,
      "radius": 2000,
      "warning": "Ultimate Berk slams the ground: walk out of the circle!",
      "warning_ru": "Берк бьёт по земле: выйдите из круга!"
    }
  ],
  "rules": [
    {
      "id": "wave_of_fury_75",
      "when": {
