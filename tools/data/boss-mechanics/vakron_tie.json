  "npcs": {"Easy": [2310810], "Normal": [2300810], "Hard": [2320810]},
  "vars": {"safe_radius": 900, "pool_ms": 20000},
  "rotation": [
    {
      "type": "cast",
      "skill": 1604450,
      "every_ms": 8000,
      "wind_up_ms": 830,
      "radius": 900,
      "warning": "Tie swipes both sides: get behind him!",
      "warning_ru": "Тай бьёт по сторонам: зайдите за спину!"
    },
    {
      "type": "cast",
      "skill": 1604460,
      "every_ms": 18000,
      "wind_up_ms": 1400,
      "radius": 2000,
      "warning": "Tie spits a stunning bolt: leave the line!",
      "warning_ru": "Тай плюёт оглушающим зарядом: уйдите с линии!"
    },
    {
      "type": "cast",
      "skill": 1604470,
      "every_ms": 15000,
      "wind_up_ms": 1100,
      "radius": 900,
      "warning": "Tie sweeps the sides: stay in front or behind!",
      "warning_ru": "Тай бьёт по бокам: встаньте спереди или сзади!"
