{
  "name": "aion-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild-account-route.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "screenshots": "playwright test",
    "prebuild": "node -e \"require('fs').rmSync('../server/Aion.Host/wwwroot/assets',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
